generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String      @id @default(uuid())
  name                String
  surname             String
  title               String?
  tc_no               String      @unique
  password_hash       String
  device_uuid         String?
  device_status       String      @default("OPEN")
  role                String      @default("USER")
  primary_location_id String?
  logs                AccessLog[]
  primary_location    Location?   @relation(fields: [primary_location_id], references: [id])
}

model Location {
  id     String      @id @default(uuid())
  name   String
  logs   AccessLog[]
  kiosks Kiosk[]
  users  User[]
}

model Kiosk {
  id            String      @id @default(uuid())
  name          String
  location_lat  Float?
  location_long Float?
  secret_key    String
  location_id   String?
  status        String      @default("ACTIVE")
  last_seen     DateTime?
  logs          AccessLog[]
  location      Location?   @relation(fields: [location_id], references: [id])
}

model AccessLog {
  id               String    @id @default(uuid())
  user_id          String
  location_id      String?
  kiosk_id         String
  timestamp        DateTime  @default(now())
  direction        String
  anomaly_flag     String?
  is_roaming       Boolean   @default(false)
  entry_method     String    @default("QR")
  photo_url        String?
  status           String
  rejection_reason String?
  kiosk            Kiosk     @relation(fields: [kiosk_id], references: [id])
  location         Location? @relation(fields: [location_id], references: [id])
  user             User      @relation(fields: [user_id], references: [id])
}
