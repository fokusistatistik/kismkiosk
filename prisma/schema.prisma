// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String       @id @default(uuid())
  name                String
  surname             String
  title               String?
  tc_no               String       @unique
  password_hash       String
  device_uuid         String?
  device_status       String       @default("OPEN") // Enum: LOCKED, OPEN
  role                String       @default("USER") // Enum: ADMIN, USER
  primary_location_id String?
  primary_location    Location?    @relation(fields: [primary_location_id], references: [id])
  logs                AccessLog[]
}

model Location {
  id    String      @id @default(uuid())
  name  String
  users User[]
  kiosks Kiosk[]
  logs  AccessLog[]
}

model Kiosk {
  id            String      @id @default(uuid())
  name          String
  location_lat  Float?
  location_long Float?
  secret_key    String
  location_id   String?
  location      Location?   @relation(fields: [location_id], references: [id])
  logs          AccessLog[]

  status        String      @default("ACTIVE") // Enum: ACTIVE, INACTIVE
  last_seen     DateTime?
}

model AccessLog {
  id              String       @id @default(uuid())
  user_id         String
  user            User         @relation(fields: [user_id], references: [id])
  
  location_id     String?
  location        Location?    @relation(fields: [location_id], references: [id])

  kiosk_id        String
  kiosk           Kiosk        @relation(fields: [kiosk_id], references: [id])

  timestamp       DateTime     @default(now())
  
  direction       String       // Enum: IN, OUT
  anomaly_flag    String?      // Enum: MISSED_EXIT, LATE_EXIT
  is_roaming      Boolean      @default(false)
  entry_method    String       @default("QR") // Enum: QR, MANUAL
  
  photo_url       String?
  status          String       // Enum: SUCCESS, FAILED
  rejection_reason String?
}
